<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:HoscyAvaloniaUi.ViewModels.SubMenus"
	xmlns:cfg="using:HoscyCore.Configuration.Modern"
	mc:Ignorable="d" d:DesignHeight="420" d:DesignWidth="689"
	x:DataType="vm:DebugSubMenuViewModelBase"
	x:Class="HoscyAvaloniaUi.Views.SubMenus.DebugSubMenu"
	Background="{StaticResource BackgroundBaseBrush}">

	<Design.DataContext>
		<vm:DebugSubMenuViewModelPreview/>
	</Design.DataContext>

	<ScrollViewer Theme="{StaticResource HScrollViewerPage}">
		<StackPanel Theme="{StaticResource HStackL}">
			<StackPanel Theme="{StaticResource HStack}">
				<!-- Header for Logging-->
				<Label Content="Logging" Theme="{StaticResource HLabelL}"/>

				<!-- Settings for Logging-->
				<StackPanel Theme="{StaticResource HStackIndent}">
					<CheckBox Theme="{StaticResource HCheckBox}" Content="Log via CMD/Terminal on Windows" IsChecked="{Binding Config.Debug_LogViaCmdOnWindows}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Debug_LogViaCmdOnWindows}"/>
					
					<CheckBox Theme="{StaticResource HCheckBox}" Content="Log via Source Terminal" IsChecked="{Binding Config.Debug_LogViaTerminal}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Debug_LogViaTerminal}"/>
					
					<CheckBox Theme="{StaticResource HCheckBox}" Content="Log via File Follow Command" IsChecked="{Binding Config.Debug_LogViaFileFollow}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Debug_LogViaFileFollow}"/>

					<StackPanel Theme="{StaticResource HStackIndent}" IsEnabled="{Binding Config.Debug_LogViaFileFollow}">
						<StackPanel Theme="{StaticResource HStackS}">
							<TextBlock Theme="{StaticResource HTextBlock}" Text="File Follow Terminal Process"/>
							<TextBox Text="{Binding Config.Debug_LogFileFollowProcess}" Tag="Process ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Debug_LogFileFollowProcess}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<TextBlock Theme="{StaticResource HTextBlock}" Text="File Follow Terminal Command"/>
							<TextBox Text="{Binding Config.Debug_LogFileFollowCommand}" Tag="Command ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Debug_LogFileFollowCommand}"/>
						</StackPanel>
					</StackPanel>

					<StackPanel Theme="{StaticResource HStackS}">
						<TextBlock Theme="{StaticResource HTextBlock}" Text="Logging Level"/>
							<WrapPanel Theme="{StaticResource HWrap}">
								<ComboBox Theme="{StaticResource HComboBoxSettings}" SelectedIndex="{Binding LogLevelIndex}" ItemsSource="{Binding LogLevels}" SelectionChanged="LogLevelChanged" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Debug_LogMinimumSeverity}"/>
								<Button Content="Edit Filters" Theme="{StaticResource HButtonSmall}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="LogFiltersClicked" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Debug_LogFilters}"/>
							</WrapPanel>
					</StackPanel>

					<CheckBox Theme="{StaticResource HCheckBox}" Content="Extra Verbose Logging" IsChecked="{Binding Config.Debug_LogVerboseExtra}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Debug_LogVerboseExtra}"/>
				</StackPanel>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
