<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:HoscyAvaloniaUi.ViewModels.SubMenus"
	xmlns:cfg="using:HoscyCore.Configuration.Modern"
	mc:Ignorable="d" d:DesignHeight="1250" d:DesignWidth="689"
	x:DataType="vm:OscSubMenuViewModelBase"
	x:Class="HoscyAvaloniaUi.Views.SubMenus.OscSubMenu"
	Background="{StaticResource BackgroundBaseBrush}">

	<Design.DataContext>
		<vm:OscSubMenuViewModelPreview/>
	</Design.DataContext>

	<ScrollViewer Theme="{StaticResource HScrollViewerPage}">
		<StackPanel Theme="{StaticResource HStackL}">
			<StackPanel Theme="{StaticResource HStack}">
				<WrapPanel Theme="{StaticResource HWrap}">
					<Label Content="Routing" Theme="{StaticResource HLabelL}"/>
					<Button Content="Relay Filters" Theme="{StaticResource HButtonSmall}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="RelayFiltersClicked" ToolTip.Tip="{StaticResource cfg:ConfigModel.DESC_Osc_Relay_Filters}"/>
					<TextBlock Theme="{StaticResource HTextBlockError}" Text="{Binding RelayFiltersInvalid}" VerticalAlignment="Center"/>
				</WrapPanel>

				<StackPanel Theme="{StaticResource HStackIndent}">
					<WrapPanel Theme="{StaticResource HWrap}">
						<TextBox Theme="{StaticResource HTextBoxShort}" PlaceholderText="IP ..." Text="{Binding Config.Osc_Routing_TargetIp, UpdateSourceTrigger=LostFocus}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Routing_TargetIp}"/>
						<Label Theme="{StaticResource HLabel}" Content="Target IP" VerticalAlignment="Center"/>
					</WrapPanel>

					<WrapPanel Theme="{StaticResource HWrap}">
						<TextBox Theme="{StaticResource HTextBoxTiny}" PlaceholderText="Port ..." Text="{Binding Config.Osc_Routing_TargetPort, UpdateSourceTrigger=LostFocus, Converter={StaticResource UshortRange}, ConverterParameter=ConfigModel.Osc_Routing_TargetPort}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Routing_TargetPort}"/>
						<Label Theme="{StaticResource HLabel}" Content="Target Port" VerticalAlignment="Center"/>
					</WrapPanel>

					<StackPanel Theme="{StaticResource HStackS}">
						<WrapPanel Theme="{StaticResource HWrap}">
							<TextBox Theme="{StaticResource HTextBoxTiny}" PlaceholderText="Port ..." Text="{Binding Config.Osc_Routing_ListenPort, Converter={StaticResource IntRange}, ConverterParameter=ConfigModel.Osc_Routing_ListenPort}" KeyUp="ListeningPortChanged" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Routing_ListenPort}"/>
							<Label Theme="{StaticResource HLabel}" Content="Listening Port" VerticalAlignment="Center"/>
							<Button Content="Reload Listener" Theme="{StaticResource HButtonSmall}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="ReloadListenerClicked" ToolTip.Tip="Reloads both OSC listener and query service"/>
						</WrapPanel>
						<TextBlock Theme="{StaticResource HTextBlockError}" Text="Listening Port not applied, please press 'Reload Listener'" VerticalAlignment="Center" IsVisible="{Binding ListeningPortUnapplied}"/>
					</StackPanel>

					<CheckBox Theme="{StaticResource HCheckBox}" Content="Ignore Handled Messages for Relay" IsChecked="{Binding Config.Osc_Relay_IgnoreIfHandled}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Relay_IgnoreIfHandled}"/>
				</StackPanel>
			</StackPanel>

			<StackPanel Theme="{StaticResource HStack}">
				<Label Content="External Input" Theme="{StaticResource HLabelL}"/>

				<StackPanel Theme="{StaticResource HStackIndent}">
					<CheckBox Theme="{StaticResource HCheckBox}" Content="Do Full Preprocessing" IsChecked="{Binding Config.ExternalInput_DoPreprocessFull}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_ExternalInput_DoPreprocessFull}"/>
					<CheckBox Theme="{StaticResource HCheckBox}" Content="Do Partial Preprocessing" IsChecked="{Binding Config.ExternalInput_DoPreprocessPartial}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_ExternalInput_DoPreprocessPartial}"/>
					<CheckBox Theme="{StaticResource HCheckBox}" Content="Do Translate" IsChecked="{Binding Config.ExternalInput_DoTranslate}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_ExternalInput_DoTranslate}"/>
				</StackPanel>
			</StackPanel>

			<StackPanel Theme="{StaticResource HStack}">
				<WrapPanel Theme="{StaticResource HWrap}">
					<Label Content="Addresses" Theme="{StaticResource HLabelL}"/>
					<Button Content="OSC Query Services" Theme="{StaticResource HButtonSmall}" HorizontalAlignment="Left" VerticalAlignment="Center" Click="QueryServicesClicked" ToolTip.Tip="View located services for OSC Query"/>
				</WrapPanel>

				<StackPanel Theme="{StaticResource HStackIndent}">
					<Label Content="Game Control" Theme="{StaticResource HLabelM}"/>

					<StackPanel Theme="{StaticResource HStackIndent}">
						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Send Message"/>
							<TextBox Text="{Binding Config.Osc_Address_Game_Textbox}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Game_Textbox}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Trigger Typing Indicator"/>
							<TextBox Text="{Binding Config.Osc_Address_Game_Typing}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Game_Typing}"/>
						</StackPanel>
					</StackPanel>

					<Label Content="Game Status Out" Theme="{StaticResource HLabelM}"/>

					<StackPanel Theme="{StaticResource HStackIndent}">
						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="On Mute"/>
							<TextBox Text="{Binding Config.Osc_Address_Game_Mute}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Game_Mute}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="On AFK"/>
							<TextBox Text="{Binding Config.Osc_Address_Game_Afk}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Game_Afk}"/>
						</StackPanel>
					</StackPanel>

					<Label Content="HOSCY Control (Media)" Theme="{StaticResource HLabelM}"/>

					<StackPanel Theme="{StaticResource HStackIndent}">
						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Toggle Playback"/>
							<TextBox Text="{Binding Config.Osc_Address_Media_Toggle}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Media_Toggle}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Pause Playback"/>
							<TextBox Text="{Binding Config.Osc_Address_Media_Pause}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Media_Pause}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Resume Playback"/>
							<TextBox Text="{Binding Config.Osc_Address_Media_Play}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Media_Play}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Previous Track"/>
							<TextBox Text="{Binding Config.Osc_Address_Media_Previous}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Media_Previous}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Next Track"/>
							<TextBox Text="{Binding Config.Osc_Address_Media_Next}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Media_Next}"/>
						</StackPanel>
					</StackPanel>

					<Label Content="HOSCY Control (Settings)" Theme="{StaticResource HLabelM}"/>

					<StackPanel Theme="{StaticResource HStackIndent}">
						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Clear Output"/>
							<TextBox Text="{Binding Config.Osc_Address_Tool_Clear}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Tool_Clear}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Toggle Speech Recognition"/>
							<TextBox Text="{Binding Config.Osc_Address_Tool_ToggleMute}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Tool_ToggleMute}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Toggle Partial Replacements"/>
							<TextBox Text="{Binding Config.Osc_Address_Tool_ToggleReplacementsPartial}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Tool_ToggleReplacementsPartial}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Toggle Full Replacements"/>
							<TextBox Text="{Binding Config.Osc_Address_Tool_ToggleReplacementsFull}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Tool_ToggleReplacementsFull}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Toggle Automatic Speech Recognition Toggle"/>
							<TextBox Text="{Binding Config.Osc_Address_Tool_ToggleRecognitionAutoMute}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Tool_ToggleRecognitionAutoMute}"/>
						</StackPanel>
					</StackPanel>

					<Label Content="HOSCY Control (External Input)" Theme="{StaticResource HLabelM}"/>

					<StackPanel Theme="{StaticResource HStackIndent}">
						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Send Text Message via HOSCY"/>
							<TextBox Text="{Binding Config.Osc_Address_Input_TextMessage}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Input_TextMessage}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Send Text Notification via HOSCY"/>
							<TextBox Text="{Binding Config.Osc_Address_Input_TextNotification}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Input_TextNotification}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Send Audio Message via HOSCY"/>
							<TextBox Text="{Binding Config.Osc_Address_Input_AudioMessage}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Input_AudioMessage}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="Send Other Message via HOSCY"/>
							<TextBox Text="{Binding Config.Osc_Address_Input_OtherMessage}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Input_OtherMessage}"/>
						</StackPanel>
					</StackPanel>

					<Label Content="HOSCY Status Out" Theme="{StaticResource HLabelM}"/>

					<StackPanel Theme="{StaticResource HStackIndent}">
						<StackPanel Theme="{StaticResource HStackS}">
							<Label Theme="{StaticResource HLabel}" Content="On Recognition Status Changed"/>
							<TextBox Text="{Binding Config.Osc_Address_Tool_NotificationForRecognitionListening}" PlaceholderText="Address ..." Theme="{StaticResource HTextBoxLong}" ToolTip.Tip="{x:Static cfg:ConfigModel.DESC_Osc_Address_Tool_NotificationForRecognitionListening}"/>
						</StackPanel>
					</StackPanel>
				</StackPanel>
			</StackPanel>
		</StackPanel>
	</ScrollViewer>
</UserControl>
