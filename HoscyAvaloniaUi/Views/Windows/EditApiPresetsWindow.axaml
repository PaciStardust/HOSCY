<Window xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:vm="using:HoscyAvaloniaUi.ViewModels.Windows"
	xmlns:cfg="using:HoscyCore.Configuration.Modern"
	mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="700"
	x:DataType="vm:EditApiPresetsWindowViewModelBase"
	x:Class="HoscyAvaloniaUi.Views.Windows.EditApiPresetsWindow"

	Title="Edit API Presets"
	MinHeight="400"
	MinWidth="700"
	Height="400"
	Width="700"
	CanResize="True"
	Background="{StaticResource BackgroundBaseBrush}" 
	WindowStartupLocation="CenterOwner">

	<Design.DataContext>
		<vm:EditApiPresetsWindowViewModelPreview/>
	</Design.DataContext>

	<Grid Margin="16" ColumnDefinitions="4*,5*">
		<ListBox Grid.Column="0" Theme="{StaticResource HListBoxF}" Margin="0,0,8,0" SelectedIndex="{Binding SelectedIndex}" ItemsSource="{Binding DataDisplayed}"
			ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Auto" SelectionChanged="SelectionChanged"/>

		<Grid Grid.Column="1" RowDefinitions="Auto,1*" Margin="8,0,0,0">
			<StackPanel Grid.Row="0" Theme="{StaticResource HStack}">
				<WrapPanel Theme="{StaticResource HWrap}" HorizontalAlignment="Center">
					<Button Theme="{StaticResource HButton}" Content="Add New" Click="AddEntry"/>
					<Button Theme="{StaticResource HButton}" Content="Remove" Click="RemoveEntry"/>
				</WrapPanel>

				<WrapPanel Theme="{StaticResource HWrap}" HorizontalAlignment="Center">
					<Button Theme="{StaticResource HButton}" Content="Modify" Click="ModifyEntry"/>
					<Button Theme="{StaticResource HButton}" Content="Headers" Click="EditHeaders" ToolTip.Tip="{x:Static cfg:ApiPresetModel.DESC_HeaderValues}"/>
				</WrapPanel>
			</StackPanel>

			<ScrollViewer Grid.Row="1" Theme="{StaticResource HScrollViewer}" Margin="0,16,0,0">
				<StackPanel Theme="{StaticResource HStack}">
					<StackPanel Theme="{StaticResource HStackS}">
						<TextBlock Theme="{StaticResource HTextBlock}" HorizontalAlignment="Center" Text="Preset Name"/>
						<TextBox Theme="{StaticResource HTextBox}" Text="{Binding SelectedPresetName}" PlaceholderText="Preset Name ..." KeyUp="KeyPressed" ToolTip.Tip="{x:Static cfg:ApiPresetModel.DESC_Name}"/>
					</StackPanel>

					<StackPanel Theme="{StaticResource HStackS}">
						<TextBlock Theme="{StaticResource HTextBlock}" HorizontalAlignment="Center" Text="Target URL"/>
						<TextBox Theme="{StaticResource HTextBoxLarge}" Text="{Binding SelectedTargetUrl}" PlaceholderText="Target URL ..." KeyUp="KeyPressed" ToolTip.Tip="{x:Static cfg:ApiPresetModel.DESC_TargetUrl}"/>
					</StackPanel>

					<Grid ColumnDefinitions="*,16,*">
						<StackPanel Theme="{StaticResource HStackS}" Grid.Column="0">
							<TextBlock Theme="{StaticResource HTextBlock}" HorizontalAlignment="Center" Text="Result Field"/>
							<TextBox Theme="{StaticResource HTextBox}" Text="{Binding SelectedResultField}" PlaceholderText="Result Field ..." KeyUp="KeyPressed" ToolTip.Tip="{x:Static cfg:ApiPresetModel.DESC_Result}"/>
						</StackPanel>

						<StackPanel Theme="{StaticResource HStackS}" Grid.Column="2">
							<TextBlock Theme="{StaticResource HTextBlock}" HorizontalAlignment="Center" Text="Timeout (ms)"/>
							<TextBox Theme="{StaticResource HTextBox}" Text="{Binding SelectedTimeoutMs, Converter={StaticResource IntRange}, ConverterParameter=ApiPresetModel.ConnectionTimeout}" PlaceholderText="Timeout ..." KeyUp="KeyPressed" ToolTip.Tip="{x:Static cfg:ApiPresetModel.DESC_ConnectionTimeout}"/>
						</StackPanel>
					</Grid>

					<StackPanel Theme="{StaticResource HStackS}">
						<TextBlock Theme="{StaticResource HTextBlock}" HorizontalAlignment="Center" Text="Content Type"/>
						<TextBox Theme="{StaticResource HTextBox}" Text="{Binding SelectedContentType}" PlaceholderText="Content Type ..." KeyUp="KeyPressed" ToolTip.Tip="{x:Static cfg:ApiPresetModel.DESC_ContentType}"/>
					</StackPanel>

					<StackPanel Theme="{StaticResource HStackS}">
						<TextBlock Theme="{StaticResource HTextBlock}" HorizontalAlignment="Center" Text="Content (Translation, [T] gets replaced)"/>
						<TextBox Theme="{StaticResource HTextBoxLarge}" Text="{Binding SelectedContentToSend}" PlaceholderText="Content ..." KeyUp="KeyPressed" ToolTip.Tip="{x:Static cfg:ApiPresetModel.DESC_ContentType}"/>
					</StackPanel>

					<StackPanel Theme="{StaticResource HStackS}">
						<TextBlock Theme="{StaticResource HTextBlock}" HorizontalAlignment="Center" Text="Authorization Header (Optional)"/>
						<TextBox Theme="{StaticResource HTextBox}" Text="{Binding SelectedAuthHeader}" PlaceholderText="Auth Header ..." KeyUp="KeyPressed" ToolTip.Tip="{x:Static cfg:ApiPresetModel.DESC_Authorization}"/>
					</StackPanel>
				</StackPanel>
			</ScrollViewer>
		</Grid>
	</Grid>
</Window>
